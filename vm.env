#!/bin/bash
# Shared VM connection settings. Source this from any script that needs to
# SSH into the VM: `source "$(dirname "${BASH_SOURCE[0]}")/vm.env"`

SSH_TARGET="debian@localhost"
SSH_PORT=2222

VM_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KNOWN_HOSTS_FILE="${VM_ENV_DIR}/ssh_known_hosts"

# accept-new trusts a host we've never seen before (recording it in
# KNOWN_HOSTS_FILE) but still refuses and errors loudly if a known host's key
# ever changes unexpectedly. LogLevel=ERROR silences the benign "Permanently
# added ... to the list of known hosts" notice without hiding that error.
SSH_OPTS=(-p "${SSH_PORT}" -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="${KNOWN_HOSTS_FILE}")
